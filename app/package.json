{
  "name": "jupiter-app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i tailwind.input.css -o ui/styles.css --minify",
    "css:watch": "tailwindcss -i tailwind.input.css -o ui/styles.css --watch",
    "build": "npm run css && node build-ui.mjs",
    "preview": "python3 -m http.server 8080 --directory ui",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "tailwindcss": "^4.0.0"
  }
}
